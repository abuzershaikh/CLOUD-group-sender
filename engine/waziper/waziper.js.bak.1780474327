const reconnectScheduler = {
  active: 0,
  maxConcurrent: 2,
  queue: [],
  timers: new Map(),
  pending: new Map(),
};

function getReconnectBackoffMs(reason = "", attempt = 0) {
  const text = `${reason}`.toLowerCase();
  const base =
    text.includes("rate-overlimit") || text.includes("too many requests") ? 15000 :
    text.includes("timed out") || text.includes("timeout") ? 8000 :
    text.includes("connection failure") || text.includes("connection closed") || text.includes("stream errored") ? 5000 :
    text.includes("websocket not open") || text.includes("not open") ? 4000 :
    text.includes("logout") || text.includes("logged out") || text.includes("bad session") ? 12000 :
    5000;
  const factor = Math.min(Math.max(Number(attempt) + 1, 1), 5);
  return Math.min(60000, base * factor);
}

async function drainReconnectQueue() {
  while (reconnectScheduler.active < reconnectScheduler.maxConcurrent && reconnectScheduler.queue.length > 0) {
    const job = reconnectScheduler.queue.shift();
    if (!job) continue;
    reconnectScheduler.active++;
    try {
      const session = sessions[job.instance_id];
      const wsState = WAZIPER.getSessionWsState(session);
      if (session?.user?.id && wsState.code === 1 && !job.force) {
        console.log(`[Reconnect] Skip ${job.instance_id} - session already open`);
        continue;
      }
      console.log(`[Reconnect] Running ${job.instance_id} source=${job.source} attempt=${job.attempt} reason=${job.reason}`);
      await job.run();
    } catch (error) {
      console.error(`[Reconnect] Failed for ${job.instance_id}:`, error.message);
    } finally {
      reconnectScheduler.active--;
    }
  }
}

function scheduleReconnect(instance_id, options = {}) {
  const reason = `${options.reason || "unknown"}`;
  const source = `${options.source || "unknown"}`;
  const force = options.force === true;
  const attempt = Number(options.attempt || 0);
  const delayMs = Number.isFinite(options.delayMs) ? options.delayMs : getReconnectBackoffMs(reason, attempt);
  const run = typeof options.run === "function" ? options.run : async () => {
    delete sessions[instance_id];
    sessions[instance_id] = await WAZIPER.makeWASocket(instance_id);
  };

  const pending = reconnectScheduler.pending.get(instance_id);
  if (pending && pending.timer) {
    clearTimeout(pending.timer);
  }

  const timer = setTimeout(() => {
    reconnectScheduler.pending.delete(instance_id);
    const existing = reconnectScheduler.queue.find(job => job.instance_id === instance_id);
    if (existing) {
      existing.reason = reason;
      existing.attempt = attempt;
      existing.source = source;
      existing.run = run;
      existing.force = force;
    } else {
      reconnectScheduler.queue.push({ instance_id, reason, attempt, source, force, run });
    }
    drainReconnectQueue();
  }, delayMs);

  reconnectScheduler.pending.set(instance_id, { timer, reason, attempt, source });
  console.log(`[Reconnect] Scheduled ${instance_id} in ${delayMs}ms source=${source} reason=${reason} attempt=${attempt}`);
}


