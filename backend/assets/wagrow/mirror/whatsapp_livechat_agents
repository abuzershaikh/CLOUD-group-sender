<script>
	$(document).ready(function () {
		// Failsafe Login Handler
		$('#loginForm').on('submit', function (e) {
			e.preventDefault();
			var form = $(this);
			var btn = form.find('button[type="submit"]');
			var originalText = btn.html();

			// Prevent double submission if Core.js also tries
			if (form.data('submitting')) return;
			form.data('submitting', true);

			btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

			var action = form.attr("action");
			var data = form.serialize();
			// Ensure CSRF is added
			if (typeof csrf !== 'undefined') {
				data += '&' + $.param({ csrf: csrf });
			}

			$.post(action, data, function (result) {
				form.data('submitting', false);
				// Parse result if needed
				if (typeof result != 'object') {
					try {
						result = $.parseJSON(result);
					} catch (e) {
						console.error("Invalid JSON response", result);
						Core.notify("Server Error", "error");
						btn.html(originalText).prop('disabled', false);
						return;
					}
				}

				if (result.status == "success") {
					Core.notify(result.message, "success");
					setTimeout(function () {
						window.location.assign(form.data('redirect'));
					}, 1500);
				} else {
					Core.notify(result.message, "error");
					btn.html(originalText).prop('disabled', false);
				}
			}).fail(function () {
				form.data('submitting', false);
				Core.notify("Request failed", "error");
				btn.html(originalText).prop('disabled', false);
			});
		});
	});
</script>

